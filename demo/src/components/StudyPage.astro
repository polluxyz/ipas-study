---
/** 沿用 Starlight 的搜尋與可存取導覽，將共通學習狀態集中在頁首。 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getData } from '../lib/content';
import { resolveRouteContext } from '../lib/navigation';
import { buildStudySidebar } from '../lib/sidebar';
interface Props { title: string; description?: string; section?: string; headings?: { depth: number; slug: string; text: string }[]; }
const { title, description, section = '學習總覽', headings = [] } = Astro.props;
const { codes, concepts, questions, byId } = await getData();
const routes = codes.map((entry) => entry.data);
const currentRoute = resolveRouteContext(Astro.url, routes, concepts.map((entry) => entry.data), questions);
const sidebar = buildStudySidebar(routes, currentRoute, new Map([...byId].map(([id, entry]) => [id, entry.data.title])));
---
<StarlightPage frontmatter={{ title, description, tableOfContents: headings.length > 0 }} headings={headings} sidebar={sidebar}>
  <div class="page-eyebrow"><span>中級 AI 應用規劃師</span><span class="dot">/</span>{section}</div>
  <div class="study-content"><slot /></div>
  <div class="local-note" data-pagefind-ignore>iPAS 中級備考手札 <span>・</span> 科目 1 與科目 3 <span>・</span> 作答紀錄儲存在此瀏覽器</div>
</StarlightPage>
