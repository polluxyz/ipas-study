---
/** 官方題組靜態產生全部答題卡；即時解析與逐題導覽共用既有介面。 */
import type { GetStaticPaths } from 'astro';
import StudyPage from '../../components/StudyPage.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import { getData } from '../../lib/content';
import { officialSets } from '../../lib/official';
export const getStaticPaths = (async () => {
  const data = await getData();
  return officialSets(data.questions).map((set) => ({ params: { id: set.id }, props: { set, titles: Object.fromEntries(data.concepts.map((entry) => [entry.data.id, entry.data.title])), units: new Map(data.codes.map((entry) => [entry.data.code, entry.data])) } }));
}) satisfies GetStaticPaths;
const { set, titles, units } = Astro.props;
const catalog = { id: set.id, session: set.session, mode: set.mode, questions: set.questions.map(({ id }) => ({ id })) };
---
<StudyPage title={set.title} section="官方題完整練習">
  <p class="lead">依原題順序完整練習。爭議題保留說明，依官方答案計分。</p>
  <div class="button-row"><a href="/official/">← 全部官方題組</a><a href="/wrong-book/">查看錯題本 →</a></div>
  <p id="official-status" role="status">正在準備官方題組…</p>
  <section id="official-practice" hidden aria-label="官方題組練習">
    <div class="quiz-progress"><div><span id="official-progress"></span><span id="official-time">累計用時 0 分 0 秒</span></div><progress id="official-progress-bar" max={set.questions.length || 1} value="0" aria-label="官方題組作答進度"></progress></div>
    <p id="official-position" class="muted"></p>
    <div id="official-cards">{set.questions.map((question) => <QuestionCard question={question} titles={titles} unit={units.get(question.codes[0])} mode={set.mode} hidden />)}</div>
    <div class="button-row official-navigation"><button class="button secondary" id="official-previous" type="button">← 上一題</button><button class="button primary" id="official-next" type="button">下一題 →</button></div>
    <p id="official-complete" role="status"></p>
  </section>
  <noscript><p>官方練習需要 JavaScript 才能逐題作答及保存進度。請啟用 JavaScript 後重新整理。</p></noscript>
  <script type="application/json" id="official-catalog" set:html={JSON.stringify(catalog).replace(/</g, '\u003c')}></script>
</StudyPage>
<script>import { initOfficial } from '../../lib/official-client'; initOfficial();</script>
<style>
  .official-navigation { margin-block: 1.5rem; }
  #official-status, #official-progress { overflow-wrap: anywhere; }
  @media (max-width: 40rem) { .quiz-progress > div { flex-direction: column; align-items: start; gap: .4rem; } }
</style>
