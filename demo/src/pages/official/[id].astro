---
/** 考古題採輪次交卷；指引練習題保留原本的即時解析流程。 */
import type { GetStaticPaths } from 'astro';
import StudyPage from '../../components/StudyPage.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import { getData } from '../../lib/content';
import { officialSets } from '../../lib/official';
import '../../styles/daily-exam.css';
export const getStaticPaths = (async () => {
  const data = await getData();
  return officialSets(data.questions).map((set) => ({ params: { id: set.id }, props: { set, titles: Object.fromEntries(data.concepts.map((entry) => [entry.data.id, entry.data.title])), units: new Map(data.codes.map((entry) => [entry.data.code, entry.data])) } }));
}) satisfies GetStaticPaths;
const { set, titles, units } = Astro.props;
const exam = set.session !== 'guide';
const catalog = { id: set.id, title: set.title, subject: set.subject, session: set.session, mode: set.mode,
  questions: set.questions.map(({ id, rev, number, subject, source, session, review }) => ({ id, rev, number, subject, source, session, review: { status: review.status } })) };
---
<StudyPage title={set.title} section="官方題完整練習">
  {exam ? <div class="official-round exam-layout">
    <a class="official-back" href="/official/">← 考古題目錄</a>
    <p id="official-status" class="exam-status" role="status">正在讀取考古題輪次…</p>
    <div id="official-save-error" class="exam-save-error" role="status" hidden><p id="official-error-message"></p><button id="official-retry" class="button secondary" type="button">重試保存</button><a id="official-reload" href="" hidden>重新載入</a></div>
    <section id="official-round-list" class="official-round-list" aria-label="考古題輪次" hidden>
      <p class="lead">依原考卷順序作答，交卷後一起檢討。每題 2 分。</p>
      <div id="official-round-action"></div><h2>已交卷輪次</h2><div id="official-round-rows"></div>
    </section>
    <p id="official-round-label" class="exam-date" hidden></p>
    <section id="official-score" class="exam-score" tabindex="-1" aria-label="本輪結果" hidden><p>已交卷・唯讀檢討・不計時</p><h2 id="official-score-heading"></h2><p id="official-score-points"></p><div id="official-review-action"></div></section>
    <section id="official-empty" class="exam-unavailable" hidden><h2>這輪已沒有可作答的題目</h2><p>題目已移除或改版，不能交卷。請重新考。</p></section>
    <div class="official-tools"><button id="official-restart" class="button secondary" type="button" hidden>重新考</button></div>
    <section id="official-practice" class="exam-grid" aria-label="考古題作答與檢討" hidden>
      <section class="exam-toolbar" aria-label="本輪進度">
        <div class="exam-toolbar-main"><strong id="official-position" class="exam-position"></strong><span id="official-time" class="exam-time" aria-live="off">本輪用時 0:00</span></div>
        <div class="exam-submission"><button id="official-submit" class="button primary exam-submit" type="button" disabled>交卷</button><span id="official-submitted" class="exam-submitted" hidden>已交卷・僅供檢討</span></div>
        <div class="exam-progress-copy"><span id="official-progress"></span><span id="official-unsure-count"></span></div>
        <progress id="official-progress-bar" class="exam-progress-bar" value="0" max="50" aria-label="已作答題數"></progress>
      </section>
      <details id="official-panel" class="exam-panel"><summary aria-expanded="false" aria-controls="official-panel-content">題號快速選單<span id="official-panel-toggle">展開</span></summary><div id="official-panel-content" class="exam-panel-content"><h2>題號快速選單</h2><nav id="official-numbers" class="exam-numbers" aria-label="題號快速選單"></nav><div id="official-legend" class="exam-legend"></div><p class="muted">雙線框是目前題目。點選題號可回看。</p></div></details>
      <section class="exam-paper" aria-labelledby="official-question-heading"><h2 id="official-question-heading" class="exam-question-heading" tabindex="-1"></h2><div id="official-cards">{set.questions.map((question) => <QuestionCard question={question} titles={titles} unit={units.get(question.codes[0])} mode="official-round" reveal="deferred" hidden />)}</div></section>
      <div class="exam-actions" aria-label="題目操作"><button id="official-previous" class="button secondary" type="button">← 上一題</button><div class="exam-forward"><button id="official-unsure" class="button secondary exam-unsure" type="button" aria-pressed="false" disabled>不確定</button><button id="official-next" class="button primary" type="button">下一題 →</button></div></div>
    </section>
    <dialog id="official-dialog" class="exam-dialog" aria-labelledby="official-dialog-heading" aria-describedby="official-dialog-description"><h2 id="official-dialog-heading">確認交卷？</h2><p id="official-dialog-description" class="exam-dialog-description">交卷後不能改答，將顯示本輪結果。</p><p id="official-dialog-count" class="exam-dialog-count"></p><div class="exam-dialog-actions"><button id="official-cancel" class="button secondary" type="button" autofocus>返回作答</button><button id="official-confirm" class="button primary" type="button">確認交卷</button></div></dialog>
    <dialog id="official-restart-dialog" class="exam-dialog" aria-labelledby="official-restart-heading" aria-describedby="official-restart-description"><h2 id="official-restart-heading">重新考這一輪？</h2><p id="official-restart-description" class="exam-dialog-description">這輪的答案、不確定標記與用時會刪除，無法找回；已交卷的輪次與舊紀錄不變。</p><div class="exam-dialog-actions"><button id="official-restart-cancel" class="button secondary" type="button" autofocus>取消，繼續作答</button><button id="official-restart-confirm" class="button primary" type="button">確認重新考</button></div></dialog>
  </div> : <>
  <p class="lead">依原題順序完整練習。爭議題保留說明，依官方答案計分。</p>
  <div class="button-row"><a href="/official/">← 全部官方題組</a><a href="/wrong-book/">查看錯題本 →</a></div>
  <p id="official-status" role="status">正在準備官方題組…</p>
  <section id="official-practice" hidden aria-label="官方題組練習">
    <div class="quiz-progress"><div><span id="official-progress"></span><span id="official-time">累計用時 0 分 0 秒</span></div><progress id="official-progress-bar" max={set.questions.length || 1} value="0" aria-label="官方題組作答進度"></progress></div>
    <p id="official-position" class="muted"></p>
    <div id="official-cards">{set.questions.map((question) => <QuestionCard question={question} titles={titles} unit={units.get(question.codes[0])} mode={set.mode} hidden />)}</div>
    <div class="button-row official-navigation"><button class="button secondary" id="official-previous" type="button">← 上一題</button><button class="button primary" id="official-next" type="button">下一題 →</button></div>
    <p id="official-complete" role="status"></p>
  </section>
  </>}
  <noscript><p>官方練習需要 JavaScript 才能逐題作答及保存進度。請啟用 JavaScript 後重新整理。</p></noscript>
  <script type="application/json" id="official-catalog" set:html={JSON.stringify(catalog).replace(/</g, '\u003c')}></script>
</StudyPage>
<script>import { initOfficial } from '../../lib/official-client'; initOfficial();</script>
<style>
  .official-back { display: inline-block; margin-bottom: 18px !important; font-size: 13px; }
  .official-round-list { padding: 24px; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); }
  .official-round-list h2 { margin-top: 28px !important; margin-bottom: 14px !important; font-size: 18px; }
  .official-round :global(.official-round-row) { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding: 16px 0; border-top: 1px solid var(--line); font-size: 14px; }
  .official-round :global(.official-round-row a) { margin-left: auto; }
  .official-round :global(.official-round-row time) { color: var(--muted); font-size: 12px; }
  .official-tools { display: flex; justify-content: end; margin-block: 12px !important; }
  #official-review-action { margin-top: 16px !important; }
  .official-round :global(.exam-unavailable) { overflow-wrap: anywhere; }
  .official-navigation { margin-block: 1.5rem; }
  #official-status, #official-progress { overflow-wrap: anywhere; }
  @media (max-width: 40rem) { .quiz-progress > div { flex-direction: column; align-items: start; gap: .4rem; } }
</style>
