---
/** 全站圖使用當版概念；文字入口由伺服器產生，無JavaScript仍可閱讀。 */
import StudyPage from '../components/StudyPage.astro';
import ConceptGraph3D from '../components/ConceptGraph3D.astro';
import { getGraphData } from '../lib/graph3d-build';
const graph = await getGraphData();
---
<StudyPage title="把觀念，連成一張地圖。" description="探索科目1與科目3的全部概念、正式關係與來源。" section="概念地圖">
  <p>從全站找到概念，再查看1跳或2跳鄰接。每個概念只出現1次。正文提到的連線預設關閉。</p>
  <ConceptGraph3D />
  <details class="g3-catalog" id="concept-catalog" data-pagefind-ignore><summary>按單元閱讀全部{graph.concepts.length}個概念</summary>
    {graph.units.map((unit) => <section><h2><a href={`/codes/${unit.id}/`}>{unit.id} · {unit.title}</a></h2><p>{unit.ownedCount}個負責概念／{unit.memberCount}個成員概念。此清單按負責單元分組。</p><ul>{graph.concepts.filter((node) => node.owner === unit.id).map((node) => <li><a href={`/concepts/${node.id}/`} data-catalog-id={node.id}>{node.title}</a>{node.exception && ' · 核可閱讀入口（無正式關係）'}{node.subjects.length > 1 && ' · 跨科共用'}</li>)}</ul></section>)}
  </details>
</StudyPage>
