---
/** 每日題組先保存草稿，完成全部題目並交卷後，才一起檢討。 */
import StudyPage from '../components/StudyPage.astro';
import QuestionCard from '../components/QuestionCard.astro';
import { getData } from '../lib/content';
import type { DailyQuestion } from '../lib/daily';
import '../styles/daily-exam.css';
const { questions, concepts, codes } = await getData();
const verified = questions.filter((q) => q.source === 'mock' && q.review.status === 'verified');
const catalog: DailyQuestion[] = questions.map(({ id, rev, subject, source, codes, type, review }) => ({ id, rev, subject, source, codes, type, review: { status: review.status } }));
const titles = Object.fromEntries(concepts.map((entry) => [entry.data.id, entry.data.title]));
const units = new Map(codes.map((entry) => [entry.data.code, entry.data]));
---
<StudyPage title="每日題組，完成後一起檢討。" section="每日 50 題">
  <div class="daily-exam">
    <p class="lead">每天每科最多 50 題。先完成全部題目，再交卷檢討。</p>
    <nav class="daily-subjects" aria-label="切換每日題組科目">
      <a href="/daily/?subject=1" data-daily-subject="1"><strong>科目 1</strong><span>人工智慧技術應用與規劃</span><small data-subject-progress></small></a>
      <a href="/daily/?subject=3" data-daily-subject="3"><strong>科目 3</strong><span>機器學習技術與應用</span><small data-subject-progress></small></a>
    </nav>
    <p id="daily-date" class="muted"></p>
    <p id="daily-status" role="status">正在準備題組…</p>
    <p id="daily-legacy" class="muted" hidden>部分解析曾顯示；已沿用先前作答，計入本次成績。</p>
    <div id="daily-save-error" role="status" hidden><p id="daily-error-message"></p><button id="daily-retry" class="button secondary" type="button">重試保存</button><a href="" id="daily-reload" hidden>重新載入</a></div>
    <section id="daily-score" class="daily-score" tabindex="-1" aria-label="本次練習結果" hidden><h2 id="daily-score-heading"></h2><p id="daily-score-points"></p></section>
    <p id="daily-today-note" class="muted" hidden></p>
    <button type="button" id="daily-today" class="button secondary" hidden>開啟今日題組</button>
    <section id="daily-practice" class="daily-grid" hidden aria-label="每日題組">
      <section class="daily-toolbar" aria-label="題組進度">
        <div class="daily-toolbar-main"><strong id="daily-position"></strong><span id="daily-time" aria-live="off">累計用時 0:00</span></div>
        <div class="daily-submission"><button id="daily-submit" class="button primary" type="button" disabled>交卷</button><span id="daily-submitted" hidden>已交卷・僅供檢討</span></div>
        <div class="daily-progress-copy"><span id="daily-progress"></span><span id="daily-unsure-count"></span></div>
        <progress id="daily-progress-bar" value="0" max="50" aria-label="已作答題數"></progress>
      </section>
      <details id="daily-panel" class="daily-panel">
        <summary aria-expanded="false" aria-controls="daily-panel-content">題號快速選單<span id="daily-panel-toggle">展開</span></summary>
        <div id="daily-panel-content"><h2>題號快速選單</h2><nav id="daily-numbers" class="daily-numbers" aria-label="題號快速選單"></nav><div id="daily-legend" class="daily-legend"></div><p class="muted">雙線框是目前題目。點選題號可回看。</p></div>
      </details>
      <section class="daily-paper" aria-labelledby="daily-question-heading">
        <h2 id="daily-question-heading" tabindex="-1"></h2>
        <div id="daily-cards">{verified.map((question) => <QuestionCard question={question} titles={titles} unit={units.get(question.codes[0])} mode="daily" reveal="deferred" hidden />)}</div>
      </section>
      <div class="daily-actions" aria-label="題目操作"><button class="button secondary" id="daily-previous" type="button">← 上一題</button><div class="daily-forward"><button class="button secondary" id="daily-unsure" type="button" aria-pressed="false" disabled>不確定</button><button class="button primary" id="daily-next" type="button">下一題 →</button></div></div>
    </section>
    <p id="daily-remaining" class="muted"></p>
    <div class="button-row daily-links"><a href="/official/">官方題完整練習</a><a href="/quiz/?wrong=1">另開錯題練習</a><a href="/wrong-book/">錯題本與備份</a></div>
    <p class="muted daily-backup-note">備份只包含正式作答與已讀紀錄。每日草稿、不確定標記與題組順序不會匯出。清除資料會一併刪除草稿；再匯入備份也無法恢復。</p>
    <dialog id="daily-dialog" aria-labelledby="daily-dialog-heading" aria-describedby="daily-dialog-description"><h2 id="daily-dialog-heading">確認交卷？</h2><p id="daily-dialog-description">交卷後不能改答，將顯示本次結果。</p><p id="daily-dialog-count"></p><div class="daily-dialog-actions"><button id="daily-cancel" class="button secondary" type="button" autofocus>返回作答</button><button id="daily-confirm" class="button primary" type="button">確認交卷</button></div></dialog>
  </div>
  <noscript><p>每日練習需要 JavaScript 才能建立題組及保存草稿。</p></noscript>
  <script type="application/json" id="daily-catalog" set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')}></script>
</StudyPage>
<script>
  import { initDaily } from '../lib/daily-client';
  initDaily();
</script>
