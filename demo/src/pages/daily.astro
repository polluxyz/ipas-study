---
/** 每日練習沿用答題卡與解析；題組在瀏覽器依台北日期建立並保存。 */
import StudyPage from '../components/StudyPage.astro';
import QuestionCard from '../components/QuestionCard.astro';
import { getData } from '../lib/content';
import type { DailyQuestion } from '../lib/daily';
const { questions, concepts, codes } = await getData();
const verified = questions.filter((q) => q.review.status === 'verified');
const catalog: DailyQuestion[] = questions.map(({ id, rev, subject, source, codes, type, review }) => ({ id, rev, subject, source, codes, type, review: { status: review.status } }));
const titles = Object.fromEntries(concepts.map((entry) => [entry.data.id, entry.data.title]));
const units = new Map(codes.map((entry) => [entry.data.code, entry.data]));
---
<StudyPage title="每天 50 題，累積新的理解。" section="每日 50 題">
  <p class="lead">只練未做過、已通過審查的題目。每日題組依台北日期固定，作答後立即看解析。</p>
  <form class="daily-subject-form" action="/daily/" method="get">
    <label for="daily-subject">練習科目<select id="daily-subject" name="subject"><option value="1">科目 1・人工智慧技術應用與規劃</option><option value="3">科目 3・機器學習技術與應用</option></select></label>
    <button class="button primary" type="submit">開啟今日題組</button>
  </form>
  <p id="daily-date" class="muted"></p>
  <p id="daily-status" role="status">正在準備今日題組…</p>
  <p id="daily-remaining" class="muted"></p>
  <div class="button-row daily-links"><a class="text-link" href="/quiz/?wrong=1">另開錯題練習 →</a><a class="text-link" href="/wrong-book/">查看錯題本 →</a></div>
  <section id="daily-practice" hidden aria-label="今日練習">
    <div class="quiz-progress"><div><span id="daily-progress">已答 0／50 題・答對 0 題</span><span id="daily-time">累計用時 0 分 0 秒</span></div><progress id="daily-progress-bar" max="50" value="0" aria-label="每日作答進度"></progress></div>
    <p id="daily-position" class="muted"></p>
    <div id="daily-cards">{verified.map((question) => <QuestionCard question={question} titles={titles} unit={units.get(question.codes[0])} mode="daily" hidden />)}</div>
    <div class="button-row daily-navigation"><button class="button secondary" id="daily-previous" type="button">← 上一題</button><button class="button primary" id="daily-next" type="button">下一題 →</button></div>
    <p id="daily-complete" role="status"></p>
  </section>
  <noscript><p>每日練習需要 JavaScript 才能抽題、保存當日題組及記錄作答。請啟用 JavaScript 後重新整理。</p></noscript>
  <script type="application/json" id="daily-catalog" set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')}></script>
</StudyPage>
<script>
  import { initDaily } from '../lib/daily-client';
  initDaily();
</script>
<style>
  .daily-subject-form { display: flex; align-items: end; flex-wrap: wrap; gap: 1rem; margin-block: 1.5rem; }
  .daily-subject-form label { display: grid; gap: .5rem; min-width: 0; flex: 1 1 16rem; }
  .daily-subject-form select { width: 100%; min-width: 0; min-height: 2.75rem; padding: .5rem; background: var(--sl-color-bg); color: var(--sl-color-text); border: 1px solid var(--sl-color-gray-4); border-radius: .4rem; font: inherit; }
  .daily-links, .daily-navigation { margin-block: 1.5rem; }
  #daily-status, #daily-remaining, #daily-progress { overflow-wrap: anywhere; }
  @media (max-width: 40rem) { .quiz-progress > div { flex-direction: column; align-items: start; gap: .4rem; } }
</style>
